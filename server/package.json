{
  "name": "sapphire-platform-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "npx prisma migrate deploy && node src/index.js",
    "start:web": "npm --prefix ../frontend run build && node src/index.js",
    "dev:all": "concurrently -n api,web -c blue,cyan \"npm run dev\" \"cross-env VITE_API_BASE=http://localhost:5000 npm --prefix ../frontend run dev\"",
    "test": "cross-env NODE_ENV=test vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "assemblyai": "^4.7.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^9.14.1",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "helmet": "^8.1.0",
    "https-proxy-agent": "^7.0.4",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "openai": "^4.56.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.4",
    "prisma": "^5.19.1",
    "prisma-erd-generator": "^2.3.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.1"
  }
}